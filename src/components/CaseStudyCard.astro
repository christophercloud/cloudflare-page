---
import ChevronRightIcon from "@components/Icons/ChevronRight.astro";

interface Metric {
  value: string;
  label: string;
}

interface Props {
  slug: string;
  title: string;
  industry: string;
  service: string;
  summary: string;
  metrics: Metric[];
  compact?: boolean;
}

const { slug, title, industry, service, summary, metrics, compact = false } = Astro.props;
const primaryMetric = metrics[0];
---

<a href={`/case-studies/${slug}`} data-astro-prefetch="tap" class="group block rounded-xl border border-surface-800 bg-surface-900/40 p-6 sm:p-8 transition-all duration-300 hover:border-primary-500/40 hover:bg-surface-900/70">
  <div class="flex items-center gap-2 text-xs">
    <span class="px-2 py-0.5 rounded-full bg-surface-800 text-surface-300 border border-surface-700">{industry}</span>
    <span class="text-surface-500">·</span>
    <span class="text-surface-400">{service}</span>
  </div>

  {primaryMetric && (
    <div class="mt-6">
      <div class="text-4xl sm:text-5xl font-bold text-primary-300 tracking-tight tabular-nums">
        {primaryMetric.value}
      </div>
      <div class="mt-1 text-sm text-surface-400">{primaryMetric.label}</div>
    </div>
  )}

  <h3 class="mt-6 text-lg font-semibold text-heading group-hover:text-primary-300 transition-colors">
    {title}
  </h3>

  {!compact && (
    <p class="mt-3 text-sm text-surface-400 leading-relaxed line-clamp-3">
      {summary}
    </p>
  )}

  <div class="mt-5 inline-flex items-center gap-1 text-sm text-primary-400 group-hover:gap-2 transition-all">
    Read the case study
    <ChevronRightIcon class="w-4 h-4" />
  </div>
</a>
