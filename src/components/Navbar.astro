---
import MenuIcon from "@/components/Icons/Menu.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { navLinks } from "@/data/navigation";
import { siteConfig } from "@/config";

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-surface-800/50 bg-surface-950/80 backdrop-blur-xl">
  <div class="section-container">
    <div class="flex items-center justify-between h-16">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-7 h-7 text-primary-400" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22 12a6 6 0 00-11.65-2A5 5 0 007 22h15a5 5 0 000-10z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M12 17l3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="font-semibold text-heading tracking-tight group-hover:text-primary-400 transition-colors">
          {siteConfig.shortTitle}
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-astro-prefetch="tap"
            class:list={[
              "px-3 py-2 text-sm rounded-md transition-colors duration-200",
              isActive(link.href)
                ? "text-primary-400 bg-primary-500/10"
                : "text-surface-400 hover:text-heading hover:bg-surface-800/50",
            ]}
          >
            {link.label}
          </a>
        ))}

        <a
          href="/contact"
          data-astro-prefetch="tap"
          class="ml-2 inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 transition-colors"
        >
          Start a Project
        </a>

        <ThemeToggle label="Toggle theme" />
      </div>

      <!-- Mobile Controls -->
      <div class="md:hidden flex items-center gap-2">
        <ThemeToggle label="Toggle theme" />
        <button
          id="mobile-menu-btn"
          class="p-2 text-surface-400 hover:text-heading transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <MenuIcon class="w-6 h-6" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-surface-800/50 bg-surface-950/95 backdrop-blur-xl">
    <div class="px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-astro-prefetch="tap"
          class:list={[
            "block px-3 py-2 text-sm rounded-md transition-colors duration-200",
            isActive(link.href)
              ? "text-primary-400 bg-primary-500/10"
              : "text-surface-400 hover:text-heading hover:bg-surface-800/50",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="block mt-3 text-center px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 transition-colors"
      >
        Start a Project
      </a>
    </div>
  </div>
</nav>

<div class="h-16"></div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
