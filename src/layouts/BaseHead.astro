---
import "@/styles/global.css";
import { siteConfig } from "@/config";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  publishedDate?: string;
}

const {
  title,
  description = siteConfig.description,
  image = "/og-default.png",
  canonicalUrl = Astro.url.href,
  type = "website",
  publishedDate,
} = Astro.props;

const siteTitle = title === "Home" ? siteConfig.title : `${title} | ${siteConfig.shortTitle}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <script is:inline>
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteConfig.title} />

    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />


    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": siteConfig.title,
      "url": canonicalUrl,
      "description": description,
      "founder": {
        "@type": "Person",
        "name": siteConfig.founder,
      },
      "sameAs": [
        "https://github.com/cjt0060",
        "https://linkedin.com/in/christopher-j-trejo"
      ]
    })} />
  </head>
  <body
    class="min-h-screen bg-surface-950 text-surface-100 font-sans antialiased selection:bg-primary-500/30"
  >
    <slot />
  </body>
</html>
