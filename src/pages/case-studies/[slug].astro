---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TechBadge from "@components/TechBadge.astro";
import CTA from "@components/CTA.astro";
import { caseStudies } from "@/data/caseStudies";

export function getStaticPaths() {
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { caseStudy: cs },
  }));
}

const { caseStudy } = Astro.props;
---

<BaseLayout title={caseStudy.title} description={caseStudy.summary}>
  <section class="section-padding border-b border-surface-800/50">
    <div class="section-container">
      <div class="max-w-4xl">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Case Studies", href: "/case-studies" },
            { label: caseStudy.title },
          ]}
        />

        <div class="mt-8 flex flex-wrap items-center gap-2 text-xs">
          <span class="px-2 py-0.5 rounded-full bg-surface-800 text-surface-300 border border-surface-700">{caseStudy.industry}</span>
          <span class="text-surface-500">·</span>
          <span class="text-surface-400">{caseStudy.service}</span>
          <span class="text-surface-500">·</span>
          <span class="text-surface-400">{caseStudy.timeline}</span>
        </div>

        <h1 class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-heading">
          {caseStudy.title}
        </h1>
        <p class="mt-5 text-lg text-surface-300 leading-relaxed max-w-3xl">
          {caseStudy.summary}
        </p>

        <!-- Metrics -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4">
          {caseStudy.metrics.map((metric) => (
            <div class="rounded-xl border border-surface-800 bg-surface-900/40 p-6">
              <div class="text-3xl sm:text-4xl font-bold text-primary-300 tracking-tight tabular-nums">
                {metric.value}
              </div>
              <div class="mt-2 text-sm text-surface-400">{metric.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-3xl space-y-16">
        <div>
          <h2 class="text-2xl font-bold text-heading tracking-tight">The challenge</h2>
          <p class="mt-6 text-surface-300 leading-relaxed">{caseStudy.challenge}</p>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-heading tracking-tight">Our approach</h2>
          <ol class="mt-6 space-y-4">
            {caseStudy.approach.map((step, index) => (
              <li class="flex items-start gap-4 text-surface-300">
                <span class="flex-shrink-0 w-7 h-7 rounded-full bg-primary-500/10 text-primary-400 border border-primary-500/20 flex items-center justify-center text-xs font-medium tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="leading-relaxed pt-0.5">{step}</span>
              </li>
            ))}
          </ol>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-heading tracking-tight">The outcome</h2>
          <p class="mt-6 text-surface-300 leading-relaxed">{caseStudy.outcome}</p>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-heading tracking-tight">Technology stack</h2>
          <div class="mt-6 flex flex-wrap gap-2">
            {caseStudy.technologies.map((tech) => (
              <TechBadge name={tech} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Facing something similar?"
    description="Every engagement is different, but we've probably seen a version of it. Send us the shape of the problem and we'll tell you honestly whether we can help."
    primaryCTA={{ label: "Start a Project", href: "/contact" }}
    secondaryCTA={{ label: "More Case Studies", href: "/case-studies" }}
  />
</BaseLayout>
