---
import BaseLayout from "@layouts/BaseLayout.astro";
import { services } from "@/data/services";
import { siteConfig } from "@/config";
---

<BaseLayout
  title="Contact"
  description="Start a project with Surefire Cloud Consultancy — tell us about your scope, timeline, and constraints."
>
  <section class="section-padding border-b border-surface-800/50">
    <div class="section-container">
      <div class="max-w-3xl">
        <span class="text-sm font-medium text-primary-400">Get in touch</span>
        <h1 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-heading">
          Tell us about the project.
        </h1>
        <p class="mt-6 text-lg text-surface-300 leading-relaxed">
          The more you can share up front, the faster we can tell you whether we're the right fit. We reply to every inquiry within one business day — even if the answer is "not us, but here's who to talk to."
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Form -->
        <div class="lg:col-span-2">
          <form
            action={siteConfig.contactFormEndpoint}
            method="POST"
            class="space-y-6"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-surface-300 mb-2">
                  Your name <span class="text-primary-400">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading placeholder-surface-500 focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
                  placeholder="Jane Doe"
                />
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-surface-300 mb-2">
                  Company <span class="text-primary-400">*</span>
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  autocomplete="organization"
                  class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading placeholder-surface-500 focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
                  placeholder="Acme, Inc."
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-medium text-surface-300 mb-2">
                  Work email <span class="text-primary-400">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading placeholder-surface-500 focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
                  placeholder="jane@company.com"
                />
              </div>
              <div>
                <label for="role" class="block text-sm font-medium text-surface-300 mb-2">
                  Your role
                </label>
                <input
                  type="text"
                  id="role"
                  name="role"
                  autocomplete="organization-title"
                  class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading placeholder-surface-500 focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
                  placeholder="VP Engineering"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-surface-300 mb-2">
                What kind of engagement? <span class="text-primary-400">*</span>
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              >
                <option value="">Select the closest fit…</option>
                {services.map((s) => (
                  <option value={s.title}>{s.title}</option>
                ))}
                <option value="Not sure yet">Not sure yet — help me scope it</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="timeline" class="block text-sm font-medium text-surface-300 mb-2">
                  Timeline
                </label>
                <select
                  id="timeline"
                  name="timeline"
                  class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
                >
                  <option value="">Select…</option>
                  <option value="ASAP">ASAP / urgent</option>
                  <option value="Within 30 days">Within 30 days</option>
                  <option value="This quarter">This quarter</option>
                  <option value="Next quarter or later">Next quarter or later</option>
                  <option value="Exploring options">Just exploring</option>
                </select>
              </div>
              <div>
                <label for="budget" class="block text-sm font-medium text-surface-300 mb-2">
                  Budget range
                </label>
                <select
                  id="budget"
                  name="budget"
                  class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
                >
                  <option value="">Select…</option>
                  <option value="Under $25K">Under $25K (discovery-only)</option>
                  <option value="$25K–$75K">$25K – $75K</option>
                  <option value="$75K–$200K">$75K – $200K</option>
                  <option value="$200K+">$200K+</option>
                  <option value="Not sure yet">Not sure yet</option>
                </select>
              </div>
            </div>

            <div>
              <label for="scope" class="block text-sm font-medium text-surface-300 mb-2">
                Tell us about the scope <span class="text-primary-400">*</span>
              </label>
              <textarea
                id="scope"
                name="scope"
                required
                rows="7"
                class="w-full px-4 py-3 rounded-lg bg-surface-900 border border-surface-700 text-heading placeholder-surface-500 focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors resize-y"
                placeholder="What are you trying to solve? What's already been tried? What does success look like? The more specific, the better."
              ></textarea>
            </div>

            <!-- Cloudflare Turnstile placeholder -->
            <div class="cf-turnstile" data-sitekey={siteConfig.turnstileSiteKey} data-theme="dark"></div>

            <button type="submit" class="btn-primary w-full sm:w-auto">
              Send Inquiry
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>

            <p class="text-xs text-surface-500">
              We treat every inquiry as confidential. NDAs available on request before we discuss specifics.
            </p>
          </form>
        </div>

        <!-- Sidebar -->
        <aside class="space-y-6">
          <div class="rounded-xl border border-surface-800 bg-surface-900/40 p-6">
            <h3 class="text-sm font-semibold text-heading mb-3">Prefer email?</h3>
            <a href={`mailto:${siteConfig.contactEmail}`} class="text-sm text-primary-400 hover:text-primary-300 transition-colors break-all">
              {siteConfig.contactEmail}
            </a>
          </div>

          <div class="rounded-xl border border-surface-800 bg-surface-900/40 p-6">
            <h3 class="text-sm font-semibold text-heading mb-3">Response time</h3>
            <p class="text-sm text-surface-400 leading-relaxed">
              Every inquiry gets a response within one business day. Urgent incidents — reach out on LinkedIn for faster escalation.
            </p>
          </div>

          <div class="rounded-xl border border-surface-800 bg-surface-900/40 p-6">
            <h3 class="text-sm font-semibold text-heading mb-3">What happens next</h3>
            <ol class="text-sm text-surface-400 space-y-2 list-decimal list-inside">
              <li>We review your inquiry within a business day</li>
              <li>A 30-minute intro call to align on scope and fit</li>
              <li>A written proposal for the discovery phase</li>
              <li>Signed SOW, and we get to work</li>
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
